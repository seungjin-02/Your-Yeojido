# Public Supabase project settings; these are included in the web/APK bundle.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Older projects can use VITE_SUPABASE_ANON_KEY instead.
# Never put service_role, database passwords, signing passwords, or access tokens here.
